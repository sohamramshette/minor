# EmotionTrace Server Environment Variables (Phase 2: MongoDB Atlas Integration)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
# 1. Sign up at https://www.mongodb.com/cloud/atlas
# 2. Create a free shared M0 cluster
# 3. Create a Database User with read/write access (e.g., dbUser / securePassword)
# 4. Under 'Network Access', add your IP address or 0.0.0.0/0 (allow access from anywhere)
# 5. Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/emotiontrace?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/emotiontrace?retryWrites=true&w=majority

# GitHub API Personal Access Token (Optional for Phase 2, required for Phase 3 Git ingestion)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
