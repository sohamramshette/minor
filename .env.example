# EmotionTrace Root Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String (Phase 2: Persistence Layer)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/emotiontrace?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/emotiontrace?retryWrites=true&w=majority

# GitHub Integration (Phase 3: Git & Blame Extraction)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
